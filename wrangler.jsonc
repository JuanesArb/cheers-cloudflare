{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cheers-cafe-bar",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
